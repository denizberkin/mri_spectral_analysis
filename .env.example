# Copy to .env at the repository root. Relative paths resolve against this file.
DATA_DIR=/path/to/MRIxFields2026          # challenge release, as distributed
PREPROCESSED_DIR=/path/to/preprocessed    # written by scripts/preprocess.py extract-slices
SUBMISSION_DIR=/path/to/submissions       # written by scripts/make_task3_submission.py
LDCT_DIR=/path/to/ldct_and_projection_data # LDCT: folder that directly contains the patient folders (C001 ... L100)
LDCT_PREPROCESSED_DIR=/path/to/ldct_preprocessed # LDCT: written by scripts/preprocess_ldct.py
CT4H_DIR=/path/to/CT4Harmonization-Multicentric # CT4H: DICOM root the index series_dir paths are relative to
CT4H_CACHE_DIR=/path/to/ct4h_cache        # CT4H: written by scripts/cache_ct4h_volumes.py (int16 .npy + cache_index.csv)
